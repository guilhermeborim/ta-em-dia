{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://ta-em-dia-api-staging.onrender.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "1032713267792-tbjph5m17m9fp00m41i20ea4qnr89vm7.apps.googleusercontent.com"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://ta-em-dia-api-staging.onrender.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "1032713267792-tbjph5m17m9fp00m41i20ea4qnr89vm7.apps.googleusercontent.com",
        "environment": "preview"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
